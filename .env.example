# PostgreSQL / Neon (obligatoria). Usa una base o rama de desarrollo para pruebas.
DATABASE_URL=postgresql://USUARIO:CLAVE@SERVIDOR.neon.tech/rodando_utp?sslmode=require
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# La contraseña administrativa debe tener 12 caracteres o más.
ADMIN_EMAIL=admin@utpuebla.edu.mx
ADMIN_PASSWORD=CambiaEstaClaveSegura2026

# Carga de demostración explícita. Déjala en false salvo al preparar una BD vacía.
ALLOW_DEMO_SEED=false
ALLOW_SQLITE_IMPORT=false

# Web Push opcional. Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@utpuebla.edu.mx

# Parser de lenguaje natural opcional. El recomendador funciona sin IA externa.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# AI_DAILY_LIMIT=50

# Solo para pruebas de integración contra un servidor local/de desarrollo.
TEST_BASE_URL=http://localhost:3000
